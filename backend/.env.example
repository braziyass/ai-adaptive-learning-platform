APP_NAME=AI Adaptive Learning Platform API
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_adaptive_learning
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
AI_USE_FALLBACK=false
AI_CHUNK_SIZE=1200
AI_CHUNK_OVERLAP=180
AI_RETRIEVAL_TOP_K=5
AI_VECTOR_STORE_PATH=app/storage/cache/ai/vectorstore
AI_CHUNK_STORE_PATH=app/storage/cache/ai/chunks.json
AI_GENERATED_ASSET_DIR=app/storage/cache/ai/generated
CORS_ORIGINS=http://localhost:3000
